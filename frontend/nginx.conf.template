# Modèle nginx : ${API_URL} est remplacé au démarrage du conteneur (envsubst de l'image officielle).
#
# Pourquoi nginx relaie /api au lieu que le navigateur appelle l'API directement ?
# Site et API restent sur la MÊME origine (https://naissance.anmbo.ca et .../api) :
#  - pas de CORS à configurer ;
#  - le cookie de connexion SameSite=Strict fonctionne sans changement (comme le proxy Vite en dev).

# « https » si un proxy en amont (Azure) l'a indiqué, sinon le schéma reçu par nginx.
map $http_x_forwarded_proto $proto_transmis {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    client_max_body_size 1m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /api/ {
        proxy_pass ${API_URL};
        # nginx parle HTTP/1.0 par défaut ; la passerelle d'Azure Container Apps exige 1.1 (sinon 426).
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Azure Container Apps aiguille selon l'en-tête Host : on envoie celui de l'API.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proto_transmis;
        proxy_ssl_server_name on;
        proxy_read_timeout 60s;
    }

    location = /health {
        access_log off;
        return 200 "OK";
    }

    # Fichiers de Vite avec empreinte dans le nom (index-DBG-ZcHH.js) : cache d'un an.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Application monopage : toute autre URL (/naissances/123, /connexion…) renvoie index.html,
    # React Router affiche ensuite la bonne page. index.html n'est jamais mis en cache.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
    }
}
