# Copiez ce fichier en « .env » (ignoré par Git) et changez les valeurs.
#   cp .env.example .env

# Mot de passe administrateur du SQL Server LOCAL (conteneur).
# 8 caractères min. avec majuscule, minuscule, chiffre et symbole. Évitez « ; » et « $ ».
MSSQL_SA_PASSWORD=Sql-Local-2026!

# Premier compte de l'application (créé au premier démarrage s'il n'existe pas).
# 10 caractères min. avec majuscule, minuscule, chiffre et caractère spécial.
COMPTE_COURRIEL=vous@exemple.ca
COMPTE_MOT_DE_PASSE=Changez-Moi-2026
